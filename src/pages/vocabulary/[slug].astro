---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const vocabularyEntries = await getCollection('vocabulary');
  return vocabularyEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.word} - Vocabulary Trainer`}>
  <main class="container mx-auto px-4 py-8 max-w-3xl">
    <!-- Back Button -->
    <a 
      href="/"
      class="inline-flex items-center text-primary-600 hover:text-primary-700 mb-8 transition-colors"
    >
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to all words
    </a>

    <!-- Word Card -->
    <article class="bg-white rounded-lg shadow-lg p-8 md:p-12">
      <!-- Header -->
      <header class="mb-8 pb-6 border-b border-gray-200">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">
          {entry.data.word}
        </h1>
        <p class="text-2xl text-gray-600 mb-4">
          {entry.data.translation}
        </p>
        <div class="flex flex-wrap gap-2">
          {entry.data.category && (
            <span class="inline-block bg-primary-100 text-primary-800 px-4 py-2 rounded-full text-sm font-medium">
              {entry.data.category}
            </span>
          )}
          {entry.data.difficulty && (
            <span class="inline-block bg-gray-100 text-gray-800 px-4 py-2 rounded-full text-sm font-medium capitalize">
              {entry.data.difficulty}
            </span>
          )}
        </div>
      </header>

      <!-- Examples Section -->
      {entry.data.examples && entry.data.examples.length > 0 && (
        <section class="mb-8">
          <h2 class="text-2xl font-semibold text-gray-800 mb-4">
            Example Sentences
          </h2>
          <ul class="space-y-3">
            {entry.data.examples.map((example) => (
              <li class="flex items-start">
                <span class="text-primary-500 mr-3 text-xl">•</span>
                <span class="text-gray-700 text-lg">{example}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Additional Content -->
      <section class="prose prose-lg max-w-none">
        <Content />
      </section>
    </article>
  </main>
</Layout>
